<mxfile host="app.diagrams.net"><diagram id="pipeline" name="Figure 2"><mxGraphModel dx="858" dy="486" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="858" pageHeight="486" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lbl0" value="Data collection and sample" style="text;html=1;align=right;verticalAlign=middle;fontFamily=Times New Roman;fontSize=13;fontStyle=1;fontColor=#52514E;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="818" height="20" as="geometry"/></mxCell><mxCell id="lbl1" value="Target, features and split" style="text;html=1;align=right;verticalAlign=middle;fontFamily=Times New Roman;fontSize=13;fontStyle=1;fontColor=#52514E;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="818" height="20" as="geometry"/></mxCell><mxCell id="lbl2" value="Models and evaluation" style="text;html=1;align=right;verticalAlign=middle;fontFamily=Times New Roman;fontSize=13;fontStyle=1;fontColor=#52514E;" vertex="1" parent="1"><mxGeometry x="20" y="348" width="818" height="20" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;1. Collection&lt;/b&gt;&lt;br&gt;Telegram API (MTProto), Telethon 1.44.0&lt;br&gt;25 channels (7 government, 18 blogger)&lt;br&gt;71,351 posts, 1 Dec 2025 – 31 Aug 2026" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#2A78D6;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;fontColor=#0B0B0B;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="36" width="246" height="104" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;2. Time of view collection&lt;/b&gt;&lt;br&gt;reconstructed from snapshots and logs&lt;br&gt;4 collection runs, 28 May – 8 Sep 2026&lt;br&gt;post age at collection 0.9–281.8 days" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#2A78D6;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;fontColor=#0B0B0B;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="306" y="36" width="246" height="104" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;3. Analytical sample&lt;/b&gt;&lt;br&gt;posts at least 14 days old at collection&lt;br&gt;groups of at least 20 posts&lt;br&gt;65,360 posts" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#2A78D6;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;fontColor=#0B0B0B;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="592" y="36" width="246" height="104" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;4. Target high_views&lt;/b&gt;&lt;br&gt;1 if views are above the median of&lt;br&gt;channel × month × collection run&lt;br&gt;class 1: 49.8% of posts" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDEFE8;strokeColor=#EB6834;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;fontColor=#0B0B0B;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="204" width="246" height="104" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;5. Features&lt;/b&gt;&lt;br&gt;set A: 49 publication features&lt;br&gt;set B: A + 100 TF-IDF/SVD components&lt;br&gt;G1: B + 6 posting-context features" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDEFE8;strokeColor=#EB6834;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;fontColor=#0B0B0B;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="306" y="204" width="246" height="104" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;6. Time split&lt;/b&gt;&lt;br&gt;training part: Dec 2025 – Jun 2026&lt;br&gt;(52,734 posts)&lt;br&gt;test part: Jul – Aug 2026 (12,626 posts)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDEFE8;strokeColor=#EB6834;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;fontColor=#0B0B0B;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="592" y="204" width="246" height="104" as="geometry"/></mxCell><mxCell id="b7" value="&lt;b&gt;7. Models&lt;/b&gt;&lt;br&gt;majority baseline; logistic regression,&lt;br&gt;kNN, decision tree, random forest,&lt;br&gt;XGBoost, LightGBM, MLP" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E7F6F0;strokeColor=#1BAF7A;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;fontColor=#0B0B0B;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="372" width="246" height="104" as="geometry"/></mxCell><mxCell id="b8" value="&lt;b&gt;8. Model selection&lt;/b&gt;&lt;br&gt;expanding-window CV by month&lt;br&gt;(validation months Apr, May, Jun 2026)&lt;br&gt;criterion: mean ROC-AUC" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E7F6F0;strokeColor=#1BAF7A;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;fontColor=#0B0B0B;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="306" y="372" width="246" height="104" as="geometry"/></mxCell><mxCell id="b9" value="&lt;b&gt;9. Test evaluation&lt;/b&gt;&lt;br&gt;accuracy, F1, ROC-AUC&lt;br&gt;permutation importance&lt;br&gt;RQ2: z-test and channel sign test" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E7F6F0;strokeColor=#1BAF7A;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=13;fontColor=#0B0B0B;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="592" y="372" width="246" height="104" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#52514E;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#52514E;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#52514E;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#52514E;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#52514E;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b7" target="b8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#52514E;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b8" target="b9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#52514E;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="715.0" y="160.0"/><mxPoint x="143.0" y="160.0"/></Array></mxGeometry></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#52514E;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="715.0" y="328.0"/><mxPoint x="143.0" y="328.0"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>